# AgentArena — Environment Variables Template
# Copy this file to .env (which is gitignored) and fill in values.
# Or set variables directly in your shell profile.

# Kaggle API (required for submitting and downloading replays)
# Get from: https://www.kaggle.com/settings/account → API → Create New Token
# Place kaggle.json in ~/.kaggle/ OR set these env vars:
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# Gemini API (optional — for future LLM integration, currently unused)
# GEMINI_API_KEY=your_key_here
